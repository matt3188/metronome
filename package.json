{
  "name": "metronome-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "check:conflicts": "node scripts/check-merge-conflicts.mjs",
    "prepare:pr": "node scripts/prepare-pr.mjs",
    "validate": "npm run check:conflicts && npm run lint && npm test && npm run build",
    "dev": "vite",
